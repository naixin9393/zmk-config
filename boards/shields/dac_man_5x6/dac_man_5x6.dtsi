// Shared Dactyl Manuform 5x6 split definition.
//
// Matrix matches the stock QMK `handwired/dactyl_manuform/5x6`:
//   cols: D4,C6,D7,E6,B4,B5 -> &pro_micro 4,5,6,7,8,9
//   rows: F6,F7,B1,B3,B2,B6 -> &pro_micro 19,18,15,14,16,10
//   diode-direction: col2row
//
// Both halves use the same local 6x6 matrix. The right half applies a
// col-offset of 6 so its local columns land in transform columns 6..11.

#include <dt-bindings/zmk/matrix_transform.h>

#include "dac_man_5x6-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
RC(4,2) RC(4,3)   RC(4,8) RC(4,9)
RC(4,4) RC(4,5)   RC(4,6) RC(4,7)
RC(5,4) RC(5,5)   RC(5,6) RC(5,7)
RC(5,2) RC(5,3)   RC(5,8) RC(5,9)
        >;
    };
};
