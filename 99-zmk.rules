# ZMK USB serial (ZMK Studio / USB logging CDC ACM), e.g. nice!nano.
# Grants the logged-in desktop user access without needing the uucp group.
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="615e", MODE="0666", SYMLINK+="zmk-studio"

# ZMK USB HID battery interface (2nd HID interface, Power Device page).
# ID_USB_INTERFACE_NUM is set by 60-persistent-hidraw.rules; interface 01 is the
# battery interface (00 is the keyboard). Exposed as /dev/zmk-battery.
ACTION=="add", SUBSYSTEM=="hidraw", ENV{ID_USB_VENDOR_ID}=="1d50", ENV{ID_USB_MODEL_ID}=="615e", ENV{ID_USB_INTERFACE_NUM}=="01", MODE="0666", SYMLINK+="zmk-battery"
